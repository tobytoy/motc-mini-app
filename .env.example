# ==========================================
# MOTC Mini App - Environment Configuration Example
# ==========================================
# 複製此檔案為 .env 並填入真實金鑰：
#   cp .env.example .env
# 請勿將含有真實金鑰的 .env 提交至 Git 倉庫！

# ------------------------------------------
# 交通部 TDX 運輸資料流通服務 (OAuth 2.0)
# 申請網址: https://tdx.transportdata.tw
# 說明: 用於取得 YouBike 即時站點、剩餘車輛、停車場車位及大眾運輸資料
# ------------------------------------------
TDX_CLIENT_ID="your_tdx_client_id_here"
TDX_CLIENT_SECRET="your_tdx_client_secret_here"
TDX_TOKEN_URL="https://tdx.transportdata.tw/auth/realms/TDXConnect/protocol/openid-connect/token"
TDX_API_BASE_URL="https://tdx.transportdata.tw/api/basic"

# ------------------------------------------
# 交通部中央氣象署 CWA 開放資料平臺
# 申請網址: https://opendata.cwa.gov.tw
# 說明: 用於取得使用者當前所在縣市之即時天氣、降雨機率及出行提醒
# ------------------------------------------
CWA_API_KEY="your_cwa_api_key_here"

# ------------------------------------------
# Google Gemini API (AI 智慧出行建議開關)
# 申請網址: https://aistudio.google.com
# 說明:
#   ENABLE_GEMINI_ADVICE: 預設為 "false"（使用極速 <1ms 邊緣規則引擎，不耗免費配額）
#                         若設為 "true" 則呼叫 gemini-3.5-flash-lite 生成個人化建議（超時自動備援回規則引擎）
# ------------------------------------------
GEMINI_API_KEY="your_gemini_api_key_here"
ENABLE_GEMINI_ADVICE="false"
# ------------------------------------------
# LINE LIFF & Messaging API 設定
# 申請網址: https://developers.line.biz/console
# 說明:
#   VITE_LIFF_ID: 在 LINE Developers Console 的 LINE Login Channel 下建立 LIFF App
#                 Endpoint URL 指向 Mini App 部署網址（例如 Cloudflare Pages 或 GitHub Pages）
# ------------------------------------------
VITE_LIFF_ID="your_line_liff_id_here"

# LINE Channel 憑證 (可選：若後端有 Bot 互動推播需使用)
LINE_CHANNEL_ID="your_line_channel_id_here"
LINE_CHANNEL_SECRET="your_line_channel_secret_here"
LINE_CHANNEL_ACCESS_TOKEN="your_line_channel_access_token_here"

# ------------------------------------------
# 交通資料來源切換 (Feature Flag)
# 說明:
#   TRANSPORT_DATA_SOURCE:
#     "direct" : 直連交通部 TDX，並啟用百米網格吸附記憶體快取 (預設推薦，節省 90% 配額)
#     "mcp"    : 委派給現有的 transport-mcp 微服務 (搭配 Redis / KV 集中快取)
# ------------------------------------------
TRANSPORT_DATA_SOURCE="direct"
TRANSPORT_MCP_BASE_URL="https://transport-mcp.tobywang2021.workers.dev"
TRANSPORT_MCP_API_KEY=""

# ------------------------------------------
# 系統與伺服器設定
# ------------------------------------------
NODE_ENV="development"
PORT=3000
