{
  "name": "motc-mini-app",
  "version": "1.0.0",
  "description": "LINE Mini App - 周邊交通即時資訊助手 (YouBike & 路外停車場 & 天氣)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "pages:dev": "wrangler pages dev dist --binding TDX_CLIENT_ID=$TDX_CLIENT_ID TDX_CLIENT_SECRET=$TDX_CLIENT_SECRET CWA_API_KEY=$CWA_API_KEY",
    "deploy": "vite build && wrangler pages deploy dist --project-name=motc-mini-dog",
    "worker:dev": "cd worker && wrangler dev",
    "worker:deploy": "cd worker && wrangler deploy",
    "worker:test": "cd worker && npm test",
    "detective:dev": "cd workers/data-detective-worker && wrangler dev",
    "detective:deploy": "cd workers/data-detective-worker && wrangler deploy",
    "detective:test": "cd workers/data-detective-worker && npm test"
  },
  "dependencies": {
    "@line/liff": "^2.24.0",
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260903.1",
    "@types/leaflet": "^1.9.16",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wrangler": "^4.129.0"
  }
}
